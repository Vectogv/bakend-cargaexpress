# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=                          # Genera con: node ace generate:key
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# CORS — en producción pon los orígenes separados por coma
# CORS_ORIGIN=https://tuapp.com,https://admin.tuapp.com

# Firebase Cloud Messaging (push notifications)
# Descarga el JSON desde Firebase Console > Configuración del proyecto > Cuentas de servicio
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Backup en Google Drive (opcional)
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json
# BACKUP_EMAIL=
