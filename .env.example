# ── Server ──
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# ── App ──
APP_KEY=
APP_URL=http://localhost:3333

# ── Session ──
SESSION_DRIVER=cookie

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=cargaexpress

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Firebase ──
FIREBASE_CREDENTIALS_PATH=

# ── Redis (opcional, fallback a memoria) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sentry (opcional) ──
SENTRY_DSN=

# ── Reservas programadas ──
# Anticipación mínima para crear una reserva (minutos)
RESERVATION_MIN_LEAD_TIME_MINUTES=120
# Anticipación con la que se inicia la búsqueda de conductor (minutos)
RESERVATION_DISPATCH_LEAD_MINUTES=120
# Ventana para detectar conflictos de horario de un conductor (minutos)
RESERVATION_CONFLICT_WINDOW_MINUTES=90
# Anticipación del recordatorio al cliente (minutos; 1440 = 24 horas)
RESERVATION_REMINDER_LEAD_MINUTES=1440
# Máximo de reservas activadas por ejecución del scheduler
RESERVATION_ACTIVATION_BATCH_SIZE=50
# Zona horaria de operación
RESERVATION_TIMEZONE=America/Bogota
# Activar el scheduler interno (false para desactivarlo)
RESERVATION_SCHEDULER_ENABLED=true

# ── Otros ──
MAPBOX_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
BACKUP_EMAIL=