# ─────────────────────────────────────────────────────────────────────────────
#  NODE / ENTORNO
# ─────────────────────────────────────────────────────────────────────────────
TZ=UTC
PORT=3333                                  # Railway lo asigna automáticamente
HOST=0.0.0.0                               # Obligatorio en Railway
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
#  APP
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_KEY=                                   # Genera con: node ace generate:key
APP_URL=https://tuapp.up.railway.app       # URL pública de la app

# ─────────────────────────────────────────────────────────────────────────────
#  SESIÓN
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie

# ─────────────────────────────────────────────────────────────────────────────
#  BASE DE DATOS — MySQL
# ─────────────────────────────────────────────────────────────────────────────
# Railway ofrece MySQL como plugin. También puedes usar Aiven gratis:
#   https://aiven.io/mysql
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=cargaexpress

# ─────────────────────────────────────────────────────────────────────────────
#  CORS — orígenes permitidos separados por coma
# ─────────────────────────────────────────────────────────────────────────────
# CORS_ORIGIN=https://tufrontend.com,https://admin.tufrontend.com

# ─────────────────────────────────────────────────────────────────────────────
#  FIREBASE CLOUD MESSAGING (push notifications)
# ─────────────────────────────────────────────────────────────────────────────
# En Railway: pega el JSON completo de la cuenta de servicio aquí en vez de
# usar ruta de archivo. El start.sh lo escribirá a disco automáticamente.
# Descarga el JSON desde: Firebase Console > Config > Cuentas de servicio
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ─────────────────────────────────────────────────────────────────────────────
#  MAPBOX (mapas en flutter_map)
# ─────────────────────────────────────────────────────────────────────────────
# Regístrate gratis en https://account.mapbox.com — plan Free: 50k cargas/mes
# MAPBOX_ACCESS_TOKEN=pk.eyJ...

# ─────────────────────────────────────────────────────────────────────────────
#  HERE GEOCODING & ROUTING (geocodificación y rutas)
# ─────────────────────────────────────────────────────────────────────────────
# Regístrate gratis en https://developer.here.com — plan Free: 1k transacciones/día
# Freemium: hasta 15k solicitudes/mes sin tarjeta
# HERE_API_KEY=your-here-api-key

# ─────────────────────────────────────────────────────────────────────────────
#  CLOUDINARY (subida de imágenes — avatares, fotos, documentos)
# ─────────────────────────────────────────────────────────────────────────────
# Regístrate gratis en https://cloudinary.com — 25GB almacenamiento, 25GB CDN/mes
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abc123def456

# ─────────────────────────────────────────────────────────────────────────────
#  SENTRY (monitoreo de errores en producción)
# ─────────────────────────────────────────────────────────────────────────────
# Regístrate gratis en https://sentry.io — plan Developer: 5k eventos/mes
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxx.ingest.sentry.io/xxxxxx

# ─────────────────────────────────────────────────────────────────────────────
#  BACKUP EN GOOGLE DRIVE (opcional)
# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json
# BACKUP_EMAIL=
