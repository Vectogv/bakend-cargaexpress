# ── Server ──
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# ── App ──
APP_KEY=
APP_URL=http://localhost:3333

# ── Session ──
SESSION_DRIVER=cookie

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=cargaexpress

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Firebase ──
# Cuenta de servicio de Firebase (Consola > Configuracion del proyecto > Cuentas de servicio).
# En Railway usa FIREBASE_CREDENTIALS_JSON con el JSON completo (texto o base64);
# FIREBASE_CREDENTIALS_PATH solo sirve si el archivo esta en el disco.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# ── Redis (opcional, fallback a memoria) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sentry (opcional) ──
SENTRY_DSN=

# ── Reservas programadas ──
# Anticipación mínima para crear una reserva (minutos)
RESERVATION_MIN_LEAD_TIME_MINUTES=120
# Anticipación con la que se inicia la búsqueda de conductor (minutos)
RESERVATION_DISPATCH_LEAD_MINUTES=120
# Ventana para detectar conflictos de horario de un conductor (minutos)
RESERVATION_CONFLICT_WINDOW_MINUTES=90
# Anticipación del recordatorio al cliente (minutos; 1440 = 24 horas)
RESERVATION_REMINDER_LEAD_MINUTES=1440
# Máximo de reservas activadas por ejecución del scheduler
RESERVATION_ACTIVATION_BATCH_SIZE=50
# Zona horaria de operación
RESERVATION_TIMEZONE=America/Bogota
# Activar el scheduler interno (false para desactivarlo)
RESERVATION_SCHEDULER_ENABLED=true

# ── Otros ──
MAPBOX_ACCESS_TOKEN=

# ── Respaldos ──
# backup:run y el respaldo manual del admin usan mysqldump (cliente MySQL instalado
# vía nixpacks.toml) contra la conexión MySQL (DB_HOST/DB_USER/DB_PASSWORD/DB_DATABASE).
# Sin las variables de Drive el respaldo queda solo en tmp/backups (efímero en Railway).
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
BACKUP_EMAIL=

# ── Archivos subidos ──
# Ruta absoluta donde se guardan los uploads. Vacío = storage/uploads (se pierde en cada redeploy).
# En Railway: adjunta un Volume al servicio (p. ej. mount path /data/uploads) y define
# UPLOADS_DIR=/data/uploads para que los archivos sobrevivan a los redeploys.
# OJO: con 2+ réplicas cada una tiene su propio disco (y Railway no permite montar un
# Volume en servicios con varias réplicas); para compartir archivos entre réplicas se
# necesita un volumen compartido u object storage (S3/R2/etc.).
UPLOADS_DIR=