# ── Server ──
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# ── App ──
APP_KEY=
APP_URL=http://localhost:3333

# ── Session ──
SESSION_DRIVER=cookie

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=cargaexpress

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Firebase ──
FIREBASE_CREDENTIALS_PATH=

# ── Redis (opcional, fallback a memoria) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sentry (opcional) ──
SENTRY_DSN=

# ── Otros ──
MAPBOX_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
BACKUP_EMAIL=